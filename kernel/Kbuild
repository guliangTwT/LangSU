ifdef KBUILD_EXTMOD
ifeq ($(CONFIG_LANGSU_DISABLE_MANAGER),y)
ccflags-y += -DCONFIG_LANGSU_DISABLE_MANAGER=1
endif
ifeq ($(CONFIG_LANGSU_DISABLE_POLICY),y)
ccflags-y += -DCONFIG_LANGSU_DISABLE_POLICY=1
endif
ifeq ($(CONFIG_LANGSU_DEBUG),y)
ccflags-y += -DCONFIG_LANGSU_DEBUG=1
endif
ifeq ($(CONFIG_LANGSU_X86_PATCH_SYSCALL_DISPATCHER),y)
ccflags-y += -DCONFIG_LANGSU_X86_PATCH_SYSCALL_DISPATCHER=1
endif
endif

ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h

ifneq ($(KBUILD_EXTMOD),)
# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
LANGSU_KERNEL_DIR := $(srcroot)
endif
endif
ifndef LANGSU_KERNEL_DIR
ifeq ($(filter /%,$(src)),)
LANGSU_KERNEL_DIR := $(srctree)/$(src)
else
LANGSU_KERNEL_DIR := $(src)
endif
endif

ccflags-y += -I$(LANGSU_KERNEL_DIR) -I$(LANGSU_KERNEL_DIR)/include

obj-$(CONFIG_LANGSU) += langsu.o

MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Workaround bazel
# https://github.com/tiann/KernelSU/pull/316#issuecomment-1479043219
GIT := $(shell PATH="$$PATH":/usr/bin:/usr/local/bin which git)
ifneq ($(GIT),)
# Check if this is a git repository
# Try to detect Git repo intelligently
GIT_ROOT := $(shell cd $(MDIR) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),)
KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
# Only set version if it's a different repo from kernel
$(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(GIT) fetch --unshallow 2>/dev/null || true)
LANGSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(GIT) rev-list --count HEAD 2>/dev/null)
LANGSU_GIT_VERSION_VALID := 1
$(info -- LangSU: Git repo detected at $(GIT_ROOT))
endif
endif
else
$(warning -- LangSU: Git not detected, make sure git is installed in your PATH!)
endif


# Calculate version if git version is available
ifdef LANGSU_GIT_VERSION_VALID
# langsu_version: major * 10000 + git version + 200 for historical reasons
$(eval LANGSU_VERSION=$(shell expr 30000 + $(LANGSU_GIT_VERSION)))
$(info -- LangSU version: $(LANGSU_VERSION))
ccflags-y += -DLANGSU_VERSION=$(LANGSU_VERSION)
else
# If there is no .git directory, use default version
$(warning "LANGSU_GIT_VERSION not defined! It is better to make LangSU a git repository!")
ccflags-y += -DLANGSU_VERSION=16
endif

LANGSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- LANGSU_NEW_DCACHE_FLUSH: $(LANGSU_NEW_DCACHE_FLUSH))

LANGSU_IS_PR_BUILD ?= 0
ifeq ($(LANGSU_IS_PR_BUILD),0)
LANGSU_PACKAGE_NAME ?= com.langsu.manager
else
LANGSU_PACKAGE_NAME ?= com.langsu.manager.pr
endif

# Signature of the LangSU release key (signing/langsu-release.jks).
# Regenerate after replacing the key:
#   keytool -exportcert -alias <alias> -keystore <ks> -file cert.der
#   size = byte length of cert.der in hex, hash = sha256 of the same file.
LANGSU_EXPECTED_SIZE ?= 0x0560
LANGSU_EXPECTED_HASH ?= adfae3276367abc271533f19e1e60b46681e477781f090b3da43f0a80ed8ffab

$(info -- LangSU Manager package name: $(LANGSU_PACKAGE_NAME))
$(info -- LangSU Manager signature size: $(LANGSU_EXPECTED_SIZE))
$(info -- LangSU Manager signature hash: $(LANGSU_EXPECTED_HASH))
$(info -- LangSU is PR Build: $(LANGSU_IS_PR_BUILD))

ccflags-y += -DLANGSU_PACKAGE_NAME=\"$(LANGSU_PACKAGE_NAME)\"
ccflags-y += -DEXPECTED_SIZE=$(LANGSU_EXPECTED_SIZE)
ccflags-y += -DEXPECTED_HASH=\"$(LANGSU_EXPECTED_HASH)\"
ccflags-y += -DLANGSU_IS_PR_BUILD=$(LANGSU_IS_PR_BUILD)

ccflags-y += -DLANGSU_NEW_DCACHE_FLUSH=$(LANGSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

